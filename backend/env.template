# 应用基本配置
NODE_ENV=development
PORT=3001
APP_NAME=梅花心易
APP_VERSION=1.0.0

# MongoDB Atlas 数据库配置
# 请替换为您的 MongoDB Atlas 连接字符串
# 示例: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/meihuaxinyi?retryWrites=true&w=majority
MONGODB_DB_NAME=meihuaxinyi

# JWT 认证配置
# 请生成一个至少32字符的随机字符串
JWT_SECRET=please-change-this-to-a-secure-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# BCrypt 密码加密配置
BCRYPT_SALT_ROUNDS=12

# Redis 配置（可选，开发环境可不配置）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# DeepSeek AI配置
DEEPSEEK_API_KEY=sk-4b874041faa641f9921ddd5990a41752
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4000
DEEPSEEK_TEMPERATURE=0.7

# Claude AI配置（可选）
CLAUDE_API_KEY=
CLAUDE_API_URL=https://api.anthropic.com/v1/messages
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# OpenAI配置（可选）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Pinecone向量数据库配置（可选）
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=meihua-knowledge-base
