# 梅花心易后端环境配置示例文件
# 复制此文件为 .env 并填入实际配置值

# 应用配置
NODE_ENV=development
PORT=3001
APP_NAME=梅花心易
APP_VERSION=1.0.0

# 数据库配置
# 生产环境 - MongoDB Atlas (请根据实际情况修改数据库名)
MONGODB_URI=mongodb+srv://yingxu0102:yourpassword@clustermeihuaxinyi.bzdajgt.mongodb.net/meihuaxinyi?retryWrites=true&w=majority
# 本地开发环境
MONGODB_LOCAL_URI=mongodb://localhost:27017/meihuaxinyi
# 测试环境
MONGODB_TEST_URI=mongodb://localhost:27017/meihuaxinyi_test
# 数据库名称
MONGODB_DB_NAME=meihuaxinyi

# 数据库连接选项
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT=5000
MONGODB_SOCKET_TIMEOUT=45000
MONGODB_CONNECT_TIMEOUT=10000
MONGODB_MAX_IDLE_TIME=30000


# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 加密配置
BCRYPT_SALT_ROUNDS=12
CRYPTO_SECRET_KEY=your-crypto-secret-key-32-chars-long

# AI服务配置
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_API_URL=https://api.anthropic.com/v1/messages
OPENAI_API_KEY=your-openai-api-key

# 外部专业算法API配置
ALGORITHM_API_URL=https://api.meihuaxinyi.com/algorithm
ALGORITHM_API_KEY=your-algorithm-api-key
ALGORITHM_TIMEOUT=30000
ALGORITHM_RETRY_ATTEMPTS=3
ALGORITHM_RETRY_DELAY=1000
ALGORITHM_ENABLE_CACHE=true
ALGORITHM_CACHE_TIMEOUT=300000
ALGORITHM_ENABLE_FALLBACK=true
ALGORITHM_FALLBACK_MODE=placeholder
ALGORITHM_ENABLE_METRICS=true
ALGORITHM_METRICS_ENDPOINT=
ALGORITHM_DEBUG=false

# 支付配置
WECHAT_PAY_APP_ID=your-wechat-app-id
WECHAT_PAY_MCH_ID=your-wechat-mch-id
WECHAT_PAY_API_KEY=your-wechat-api-key
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-alipay-private-key

# 邮件服务配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# 文件上传配置
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif

# 日志配置
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log

# 安全配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000

# 监控配置
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true
