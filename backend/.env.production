# 梅花心易后端生产环境配置文件

# 应用配置
NODE_ENV=production
PORT=3000
APP_NAME=梅花心易
APP_VERSION=1.0.0

# 数据库配置
# 生产环境请使用MongoDB Atlas或其他云数据库
MONGODB_URI=mongodb://localhost:27017/meihuaxinyi
MONGODB_DB_NAME=meihuaxinyi

# Redis配置（已禁用）
REDIS_ENABLED=false
DISABLE_REDIS=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置（生产环境请使用更强的密钥）
JWT_SECRET=meihuaxinyi-super-secret-jwt-key-for-production-change-this-to-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 加密配置
BCRYPT_SALT_ROUNDS=12
CRYPTO_SECRET_KEY=meihuaxinyi-crypto-secret-key-32chars

# AI服务配置（生产环境需要配置真实的API密钥）
CLAUDE_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=

# 安全配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 日志配置
LOG_LEVEL=warn
LOG_FILE_PATH=logs/app.log

# 监控配置
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true
